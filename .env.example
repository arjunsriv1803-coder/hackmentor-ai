# Example settings file.
#
# EASIEST WAY: don't edit this file at all - just run:   node setup.js
# It will ask for your key and write the real .env for you.
#
# If you'd rather do it by hand: copy this file, rename the copy to  .env
# and put your real key on ONE of the lines below.

# Google Gemini - get a key at https://aistudio.google.com
GEMINI_API_KEY=paste_your_key_here

# Or OpenAI instead:
# OPENAI_API_KEY=paste_your_key_here

# Or Anthropic (Claude) instead:
# ANTHROPIC_API_KEY=paste_your_key_here

# Leave this alone unless you need a different port.
PORT=3000
